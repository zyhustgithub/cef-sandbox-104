From 26c715bf2b656d0e7f57eb8c397a464cb4afae83 Mon Sep 17 00:00:00 2001
From: zengyong <zengyong@niimbot.com>
Date: Tue, 13 Oct 2026 09:32:42 +0800
Subject: [PATCH] Select architecture-specific V8 startup snapshots on macOS

---
 cef                   |  2 +-
 gin/v8_initializer.cc | 11 +++++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/cef b/cef
index dea6f60a10..ee9413170c 160000
--- a/cef
+++ b/cef
@@ -1 +1 @@
-Subproject commit dea6f60a10f0f7b553020db71bfef28fa3176e35
+Subproject commit ee9413170c23a4e0b363ccaa4379b8dfe2f2ca8b
diff --git a/gin/v8_initializer.cc b/gin/v8_initializer.cc
index b908194f58..cd839cd8bc 100644
--- a/gin/v8_initializer.cc
+++ b/gin/v8_initializer.cc
@@ -99,12 +99,23 @@ const char kSnapshotFileName32[] = "snapshot_blob_32.bin";
 #if defined(USE_V8_CONTEXT_SNAPSHOT)
 const char kV8ContextSnapshotFileName[] = V8_CONTEXT_SNAPSHOT_FILENAME;
 #endif
+#if BUILDFLAG(IS_MAC) && defined(ARCH_CPU_ARM64)
+const char kSnapshotFileName[] = "snapshot_blob.arm64.bin";
+#elif BUILDFLAG(IS_MAC) && defined(ARCH_CPU_X86_64)
+const char kSnapshotFileName[] = "snapshot_blob.x64.bin";
+#else
 const char kSnapshotFileName[] = "snapshot_blob.bin";
+#endif
 #endif  // BUILDFLAG(IS_ANDROID)
 
 const char* GetSnapshotFileName(const V8SnapshotFileType file_type) {
   switch (file_type) {
     case V8SnapshotFileType::kDefault:
+#if BUILDFLAG(IS_MAC)
+      // Build-time snapshot generators are unbundled and use V8's output name.
+      if (!base::mac::AmIBundled())
+        return "snapshot_blob.bin";
+#endif
       return kSnapshotFileName;
     case V8SnapshotFileType::kWithAdditionalContext:
 #if defined(USE_V8_CONTEXT_SNAPSHOT)
