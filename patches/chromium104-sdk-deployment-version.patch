From f26066bfcd2ab8a5ecbe7826a6d6ffa36ed38753 Mon Sep 17 00:00:00 2001
From: zengyong <zengyong@niimbot.com>
Date: Mon, 12 Oct 2026 18:53:31 +0800
Subject: [PATCH] Supply modern SDK deployment macro from Clang 15 macOS target
 version

---
 build/config/mac/BUILD.gn | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/build/config/mac/BUILD.gn b/build/config/mac/BUILD.gn
index 3e24ccbd42..f2e7e676f7 100644
--- a/build/config/mac/BUILD.gn
+++ b/build/config/mac/BUILD.gn
@@ -87,6 +87,9 @@ config("runtime_library") {
     # environment. New SDK exclave checks then incorrectly disable TARGET_OS_OSX.
     # Native macOS has none of these special environments (simulator/macabi/etc).
     defines += [ "__is_target_environment(x)=0" ]
+    # New SDKs use the platform-neutral deployment macro added after Clang 15.
+    # Preserve the actual -mmacosx-version-min value supplied to this build.
+    defines += [ "__ENVIRONMENT_OS_VERSION_MIN_REQUIRED__=__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__" ]
     cflags += [ "-Wno-builtin-macro-redefined" ]
   }
 
