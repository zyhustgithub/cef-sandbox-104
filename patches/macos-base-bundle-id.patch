From dea6f60a10f0f7b553020db71bfef28fa3176e35 Mon Sep 17 00:00:00 2001
From: zengyong <zengyong@niimbot.com>
Date: Mon, 12 Oct 2026 18:45:35 +0800
Subject: [PATCH] Support an application-group base bundle ID for macOS sandbox
 IPC

---
 libcef/common/util_mac.mm | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/libcef/common/util_mac.mm b/libcef/common/util_mac.mm
index b185273..aa699fd 100644
--- a/libcef/common/util_mac.mm
+++ b/libcef/common/util_mac.mm
@@ -113,6 +113,14 @@ bool GetLocalLibraryDirectory(base::FilePath* result) {
 }
 
 std::string GetMainBundleID() {
+  // Use an entitled application-group prefix for App Sandbox Mach IPC.
+  // The embedder must forward this switch to every CEF child process.
+  const std::string base_bundle_id =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "base-bundle-id");
+  if (!base_bundle_id.empty())
+    return base_bundle_id;
+
   NSBundle* bundle = base::mac::OuterBundle();
   return base::SysNSStringToUTF8([bundle bundleIdentifier]);
 }
