From 65bee5592dd6650ae52487ff95bc62fb8a346f84 Mon Sep 17 00:00:00 2001
From: zengyong <zengyong@niimbot.com>
Date: Tue, 13 Oct 2026 09:02:13 +0800
Subject: [PATCH] Identify macOS browser role explicitly for pseudonymization
 salt initialization

---
 content/common/pseudonymization_salt.cc | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/content/common/pseudonymization_salt.cc b/content/common/pseudonymization_salt.cc
index 28e003bef9..ed31ca6c61 100644
--- a/content/common/pseudonymization_salt.cc
+++ b/content/common/pseudonymization_salt.cc
@@ -9,10 +9,16 @@
 #include "base/check_op.h"
 #include "base/dcheck_is_on.h"
 #include "base/rand_util.h"
+#include "build/build_config.h"
 
 #if DCHECK_IS_ON()
+#if BUILDFLAG(IS_MAC)
+#include "base/command_line.h"
+#include "content/public/common/content_switches.h"
+#else
 #include "sandbox/policy/sandbox.h"
 #endif
+#endif
 
 namespace content {
 
@@ -43,9 +49,16 @@ uint32_t GetPseudonymizationSalt() {
   if (salt == 0) {
 #if DCHECK_IS_ON()
     // Only the Browser process needs to initialize the `salt` on demand.
+#if BUILDFLAG(IS_MAC)
+    // A browser hosted in an App Sandbox is sandboxed too. Identify its role
+    // explicitly; child processes must still receive the salt from the parent.
+    DCHECK(!base::CommandLine::ForCurrentProcess()->HasSwitch(
+        switches::kProcessType));
+#else
     // Other processes (identified via the IsProcessSandboxed heuristic) should
     // receive the salt from their parent processes.
     DCHECK(!sandbox::policy::Sandbox::IsProcessSandboxed());
+#endif
 #endif
     salt = InitializeSalt();
   }
