From c3b2095b6ccb84c537fc108d4e7728ab9035bf67 Mon Sep 17 00:00:00 2001
From: zengyong <zengyong@niimbot.com>
Date: Mon, 12 Oct 2026 18:45:47 +0800
Subject: [PATCH] Add opt-in Clang 15 compatibility for native macOS builds
 with newer SDKs

---
 build/config/mac/BUILD.gn | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/build/config/mac/BUILD.gn b/build/config/mac/BUILD.gn
index 8ee1760..3e24ccb 100644
--- a/build/config/mac/BUILD.gn
+++ b/build/config/mac/BUILD.gn
@@ -61,6 +61,11 @@ config("compiler") {
 # config that is applied to all targets. It is here to separate out the logic
 # that is Mac-only. Please see that target for advice on what should go in
 # :runtime_library vs. :compiler.
+declare_args() {
+  # Opt-in for native desktop builds of Chromium 104 with a newer installed SDK.
+  cef_legacy_clang_modern_sdk = false
+}
+
 config("runtime_library") {
   common_flags = [
     "-isysroot",
@@ -77,6 +82,14 @@ config("runtime_library") {
   # 'verify'.
   # http://opensource.apple.com/source/CarbonHeaders/CarbonHeaders-18.1/AssertMacros.h
   defines = [ "__ASSERT_MACROS_DEFINE_VERSIONS_WITHOUT_UNDERSCORES=0" ]
+  if (cef_legacy_clang_modern_sdk) {
+    # Clang 15 treats unknown target-environment names as the native (unknown)
+    # environment. New SDK exclave checks then incorrectly disable TARGET_OS_OSX.
+    # Native macOS has none of these special environments (simulator/macabi/etc).
+    defines += [ "__is_target_environment(x)=0" ]
+    cflags += [ "-Wno-builtin-macro-redefined" ]
+  }
+
 }
 
 # On Mac, this is used for everything except static libraries.
